# Required in Vercel. `npx convex dev` writes the local URL automatically.
NEXT_PUBLIC_CONVEX_URL=

# Required in Vercel for clone-to-own deployments. Generate a production key
# with deployment:deploy, env:view, and env:write permissions. build:auto uses
# it to provision auth/operational env, deploy Convex, and seed Demo if empty.
CONVEX_DEPLOY_KEY=

# Local Convex selection; written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Auto-provisioned on the Convex deployment by scripts/setup-auth.mjs.
# Listed only as a manual fallback; never expose these as NEXT_PUBLIC_*.
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=http://localhost:3000
DASHBOARD_PUBLIC_URL=http://localhost:3000
ACTION_API_KEY=
DEMO_RESET_KEY=

# Optional, dev-only. Media Studio (logo/poster + onboarding TTS) only runs when
# NODE_ENV=development; production is fail-closed and never calls OpenAI.
# Keep the key in .env.local only. Never commit a real key or add it to Vercel.
OPENAI_API_KEY=
