# Asisten Pribadi AI — environment template.
#
# The Convex deployment is the product surface: Custom GPT, agent harness, and the
# web dashboard all drive it. The dashboard is optional, so the variables below are
# grouped by which of those you actually need.
#   Backend only  → NEXT_PUBLIC_CONVEX_URL, CONVEX_DEPLOYMENT, ACTION_API_KEY, DEMO_RESET_KEY
#   Dashboard too → also JWT_PRIVATE_KEY, JWKS, SITE_URL, DASHBOARD_PUBLIC_URL
#
# Copy to .env.local. Never commit real values.

# Required in Vercel. `npm run convex:sync` writes the local URL automatically.
NEXT_PUBLIC_CONVEX_URL=

# Required in Vercel for clone-to-own deployments. Generate a production key
# with deployment:deploy, env:view, and env:write permissions. build:auto uses
# it to provision auth/operational env, deploy Convex, and seed Demo if empty.
CONVEX_DEPLOY_KEY=

# Local Convex selection; written automatically by `npm run convex:sync`
# (`convex dev --once`). Point this at your OWN development deployment — a value
# here that matches a deployment serving production will overwrite live functions.
CONVEX_DEPLOYMENT=

# Auto-provisioned on the Convex deployment by scripts/setup-auth.mjs.
# Listed only as a manual fallback; never expose these as NEXT_PUBLIC_*.
# JWT_PRIVATE_KEY / JWKS / SITE_URL / DASHBOARD_PUBLIC_URL are dashboard-only.
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=http://localhost:3000
DASHBOARD_PUBLIC_URL=http://localhost:3000

# Action credentials. ACTION_API_KEY authorizes the six Demo Actions; per-business
# tokens for /api/agent/* are minted in Agent Setup and stored hashed — they never
# belong in this file, in a skill file, or in an OpenAPI schema.
ACTION_API_KEY=
DEMO_RESET_KEY=

# MCP server gate. convex/http.ts registers POST /mcp; convex/mcp/auth.ts rejects
# EVERY request unless MCP_API_KEY is set and at least 32 chars, so the endpoint is
# inert until you configure it. Set it on the CONVEX deployment, not on Next — the
# whole endpoint runs in the Convex isolate:
#   npx convex env set MCP_API_KEY "$(openssl rand -hex 32)"
# The bearer alone grants NO tenant access: an MCP client must ALSO send a
# per-workspace Agent token in X-Action-API-Key (minted in "Siapkan asisten AI").
# Listed here for discoverability only; leaving it blank keeps /mcp closed.
MCP_API_KEY=

# Model provider keys — OPTIONAL and currently UNUSED. Nothing in this repo calls a
# model: the Actions are Convex reads/writes and the reasoning happens inside the Custom
# GPT or the harness, on their side of the wire. These are listed only because
# shared/lib/models.ts names them, so the day a server-side caller appears it reads a key
# from here instead of inventing its own variable. Leave them empty until then.
# One var per provider, matching PROVIDERS in shared/lib/models.ts. Server-side only:
# never rename these to NEXT_PUBLIC_*, never send them to Vercel unless a deployed
# caller needs them, and never commit a real key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
