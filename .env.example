# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
DASHBOARD_PUBLIC_URL=https://your-public-next-app.example

# Set on the Convex deployment, never expose as NEXT_PUBLIC_*.
# npx convex env set ACTION_API_KEY "replace-with-a-random-secret"
# npx convex env set DEMO_RESET_KEY "replace-with-another-random-secret"
ACTION_API_KEY=
DEMO_RESET_KEY=

# Optional, dev-only. Media Studio (logo/poster + onboarding TTS) only runs when
# NODE_ENV=development; production is fail-closed and never calls OpenAI.
# Keep the key in .env.local only. Never commit a real key or add it to Vercel.
OPENAI_API_KEY=
