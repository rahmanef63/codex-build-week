{
  "name": "asisten-pribadi-ai",
  "version": "0.1.0",
  "description": "Reference build: GPTs as your agent. One Convex backend and one set of Actions driven by a Custom GPT, an agent harness, or the optional web dashboard.",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
